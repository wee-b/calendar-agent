# Java 业务服务与鉴权：Python 调用 MCP 时转发当前用户 token。
JAVA_BASE_URL=http://127.0.0.1:8080
TOKEN_HEADER_NAME=yvli-token
JAVA_REQUEST_TIMEOUT=5
# 只读工具的总尝试次数与重试间隔（毫秒）；写操作不使用此重试配置。
MCP_READ_RETRY_ATTEMPTS=2
MCP_READ_RETRY_DELAY_MS=250
# 流式对话总超时与心跳间隔，单位均为秒。
CHAT_STREAM_TIMEOUT_SECONDS=120
CHAT_STREAM_PING_SECONDS=15

# 厂商连接：密钥只放 .env.prod 或进程环境变量，不写入本文件。
# 聊天使用兼容接口根地址；Agent 未单独指定模型时采用厂商默认模型。
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_MODEL_NAME=qwen3.7-plus
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME=deepseek-flash
# 火山方舟生图连接；ARK_API_KEY 在 .env.prod 配置，生图客户端后续接入。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL_NAME=doubao-seedream-5-0-flash-260915

# 各 Agent 的厂商、模型与温度对应 Java application-dev.yml。
# 下列模型 ID 为 Java 默认值；如 Java 通过环境变量覆盖，请同步修改这里。
# 请求超时单位为秒，为 Python 独立配置，并非 Java 配置中的值。
# Chat：普通对话。
CHAT_PROVIDER=deepseek
CHAT_MODEL_NAME=deepseek-flash
CHAT_TEMPERATURE=0.3
MODEL_REQUEST_TIMEOUT=60

# Route：低温度识别用户信号。
ROUTE_PROVIDER=aliyun
ROUTE_MODEL_NAME=qwen3.7-plus
ROUTE_TEMPERATURE=0.1
ROUTE_REQUEST_TIMEOUT=20

# Planner：沿用 PLAN_ 前缀；需要调整模型时修改 PLAN_MODEL_NAME。
PLAN_PROVIDER=deepseek
PLAN_MODEL_NAME=deepseek-flash
PLAN_TEMPERATURE=0.1
PLAN_REQUEST_TIMEOUT=60

# Executor：执行已确认的日历操作。
EXECUTOR_PROVIDER=aliyun
EXECUTOR_MODEL_NAME=qwen3.7-plus
EXECUTOR_TEMPERATURE=0.3
EXECUTOR_REQUEST_TIMEOUT=60

# Summary：会话摘要。
SUMMARY_PROVIDER=aliyun
SUMMARY_MODEL_NAME=qwen3.7-plus
SUMMARY_TEMPERATURE=0.1
SUMMARY_REQUEST_TIMEOUT=60

# Image：火山方舟生图，独立协议，不通过聊天客户端调用。
IMAGE_PROVIDER=ark
IMAGE_MODEL_NAME=doubao-seedream-5-0-flash-260915
IMAGE_SIZE=2K
IMAGE_WATERMARK=true
IMAGE_REQUEST_TIMEOUT=120

# RAG 独立检索配置；Qdrant REST 使用 6333 端口，复用现有 rag_corpus 集合。
# Embedding 使用阿里云模型，并保留独立连接地址。
# 密钥优先使用 .env.prod 的 RAG_EMBEDDING_API_KEY，否则使用 ALIYUN_API_KEY。
# RAG_EMBEDDING_MODEL 为向量模型 ID，RAG_EMBEDDING_TIMEOUT 单位为秒。
RAG_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_TIMEOUT=120
# Qdrant 向量库连接；切换向量模型后需要核对集合维度。
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_corpus
QDRANT_TIMEOUT=10
# RAG 检索：最终条数、两路召回条数、召回阈值及是否启用模型重排。
RAG_TOP_K=3
RAG_BM25_TOP_K=10
RAG_DENSE_TOP_K=10
RAG_RECALL_THRESHOLD=0.015
RAG_RERANK_ENABLED=false
# Embedding 与检索结果缓存有效期，单位为秒。
RAG_EMBEDDING_CACHE_TTL=86400
RAG_RESULT_CACHE_TTL=1800
# Redis 需与 Java Sa-Token 使用同一数据库；连接 URL 可能包含凭证，勿输出到日志。
REDIS_URL=redis://:123@127.0.0.1:6379/15
# Python AI 数据的 MySQL 连接；URL 中的特殊字符需要编码。
DATABASE_URL=mysql+aiomysql://root:123@127.0.0.1:3306/yl_database?charset=utf8mb4
